# TC Macro public ingress (G1).
# Upstream hostnames must match Sliplane private DNS: <service>.internal
# Macro routers mount under /<prefix>; keep prefix when proxying.

{
	auto_https off
}

:{$PORT:8080} {
	encode gzip

	# Liveness for Sliplane health checks
	handle /health {
		respond "ok" 200
	}

	# Same-origin API paths (mirror local proxy / production gateway prefixes)
	handle /auth* {
		reverse_proxy {$TC_MACRO_AUTH_HOST:tc-macro-auth.internal}:{$TC_MACRO_AUTH_PORT:8080}
	}
	handle /dss* {
		reverse_proxy {$TC_MACRO_DSS_HOST:tc-macro-dss.internal}:{$TC_MACRO_DSS_PORT:8080}
	}
	handle /cognition* {
		reverse_proxy {$TC_MACRO_COGNITION_HOST:tc-macro-cognition.internal}:{$TC_MACRO_COGNITION_PORT:8080}
	}
	handle /notification* {
		reverse_proxy {$TC_MACRO_NOTIFY_HOST:tc-macro-notify.internal}:{$TC_MACRO_NOTIFY_PORT:8080}
	}
	handle /agent-harness* {
		reverse_proxy {$TC_MACRO_AGENT_HOST:tc-macro-agent.internal}:{$TC_MACRO_AGENT_PORT:8080}
	}
	handle /lexical* {
		reverse_proxy {$TC_MACRO_LEXICAL_HOST:tc-macro-lexical.internal}:{$TC_MACRO_LEXICAL_PORT:8080}
	}
	handle /preview* {
		reverse_proxy {$TC_MACRO_PREVIEW_HOST:tc-macro-preview.internal}:{$TC_MACRO_PREVIEW_PORT:8080}
	}
	handle /static-file* {
		reverse_proxy {$TC_MACRO_STATIC_HOST:tc-macro-static.internal}:{$TC_MACRO_STATIC_PORT:8080}
	}
	handle /unfurl* {
		reverse_proxy {$TC_MACRO_UNFURL_HOST:tc-macro-unfurl.internal}:{$TC_MACRO_UNFURL_PORT:8080}
	}
	handle /image-proxy* {
		reverse_proxy {$TC_MACRO_IMAGE_PROXY_HOST:tc-macro-image-proxy.internal}:{$TC_MACRO_IMAGE_PROXY_PORT:8080}
	}
	handle /search-processing* {
		reverse_proxy {$TC_MACRO_SEARCH_HOST:tc-macro-search.internal}:{$TC_MACRO_SEARCH_PORT:8080}
	}
	handle /connection-gateway* {
		reverse_proxy {$TC_MACRO_CONN_GW_HOST:tc-macro-connection-gw.internal}:{$TC_MACRO_CONN_GW_PORT:8080}
	}
	handle /websocket* {
		reverse_proxy {$TC_MACRO_WS_HOST:tc-macro-ws.internal}:{$TC_MACRO_WS_PORT:8080}
	}

	# Document sync is a Cloudflare Worker (not Sliplane). Wire the browser
	# directly to the TC CF worker URL in web config; do not pretend Miniflare
	# is production here.

	# Frontend SPA / static assets
	handle {
		reverse_proxy {$TC_MACRO_WEB_HOST:tc-macro-web.internal}:{$TC_MACRO_WEB_PORT:3000}
	}
}
